# Backend Environment Variables Template (Development)
# Used when running local development server (port 5000)

PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database URL
# Format: postgresql://<user>:<password>@<host-pooler>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-dark-morning-b46qd8nq-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret for Session Authentication (minimum 16 characters)
JWT_SECRET=super_secret_jwt_key_at_least_16_characters_long
JWT_EXPIRES_IN=7d

# Base URLs
APP_BASE_URL=http://localhost:5000
DYNAMIC_QR_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
TRUST_PROXY=1
