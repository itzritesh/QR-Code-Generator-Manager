# Backend Environment Variables Template (Production)
# Configure these in your Render or Railway Dashboard under Environment Variables

# Service Port (Injected automatically by Render/Railway; default 10000 or dynamic)
PORT=10000
NODE_ENV=production

# -----------------------------------------------------------------------------
# NEON POSTGRESQL DATABASE
# -----------------------------------------------------------------------------
# Obtain from Neon Console (Dashboard -> Connection Details -> Pooled Connection)
# Example: postgresql://<user>:<password>@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-dark-morning-b46qd8nq-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# Generate a strong 64-character random string using: openssl rand -hex 32
JWT_SECRET=generate_a_secure_random_64_character_hex_string_here
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# DOMAINS & ROUTING
# -----------------------------------------------------------------------------
# APP_BASE_URL: The public HTTPS URL where this backend service is hosted.
# Used for backend health checks and fallback shortlinks.
# Example: https://qr-backend.onrender.com or https://api.yourdomain.com
APP_BASE_URL=https://api.yourdomain.com

# DYNAMIC_QR_BASE_URL: (CRITICAL) The domain used when generating dynamic QR codes.
# When users scan the QR code with their mobile phone camera, they will hit:
# `${DYNAMIC_QR_BASE_URL}/q/:shortCode`
# Set this to your custom domain or backend public URL:
# Example: https://api.yourdomain.com or https://qr-backend.onrender.com
DYNAMIC_QR_BASE_URL=https://api.yourdomain.com

# FRONTEND_URL: The public URL of the deployed frontend on Vercel or Custom Domain.
# Example: https://qr-platform.vercel.app or https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# CORS_ORIGIN: Allowed origins for cross-origin resource sharing.
# Comma-separated list of allowed web applications.
# Example: https://yourdomain.com,https://qr-platform.vercel.app
CORS_ORIGIN=https://yourdomain.com,https://qr-platform.vercel.app

# -----------------------------------------------------------------------------
# PERFORMANCE & PROXY SETTINGS
# -----------------------------------------------------------------------------
# Reverse proxy trust level (1 for Render, Railway, Vercel, Cloudflare)
TRUST_PROXY=1

# Rate limiting (900000ms = 15 minutes, 300 requests per IP window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
