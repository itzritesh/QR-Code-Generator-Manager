{
  "name": "qr-code-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for QR Code Generator & Management Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:validate": "node node_modules/prisma/build/index.js validate",
    "prisma:push": "node node_modules/prisma/build/index.js db push",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "prisma:migrate:status": "node node_modules/prisma/build/index.js migrate status",
    "prisma:migrate:baseline": "node node_modules/prisma/build/index.js migrate resolve --applied 20241001000000_init"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.9",
    "@types/qrcode": "^1.5.6",
    "prisma": "^5.17.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}
