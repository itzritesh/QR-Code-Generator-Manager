# Frontend Environment Variables Template (Production - Vercel)
# Configure these in your Vercel Project Settings -> Environment Variables

# The public HTTPS URL of your deployed backend API (Render, Railway, or Custom Domain)
# Examples:
#   Render:  https://qr-backend.onrender.com
#   Railway: https://qr-backend.up.railway.app
#   Custom:  https://api.yourdomain.com
# Note: Do not expose database credentials, JWT secrets, or private server keys here!
VITE_API_URL=https://api.yourdomain.com

# Application Title
VITE_APP_TITLE=QR Code Generator & Management Platform
