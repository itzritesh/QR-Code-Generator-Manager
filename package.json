{
  "name": "qr-code-generator-and-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready QR Code Generator & Management Platform",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:validate": "npm --prefix backend run prisma:validate",
    "prisma:migrate:deploy": "npm --prefix backend run prisma:migrate:deploy",
    "prisma:migrate:status": "npm --prefix backend run prisma:migrate:status"
  },
  "keywords": [
    "qr-code",
    "saas",
    "react",
    "express",
    "postgresql",
    "neon",
    "prisma"
  ],
  "author": "",
  "license": "ISC"
}
